# --- Required secrets -------------------------------------------------
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Get a free token at https://huggingface.co/settings/tokens (read access is enough)
HUGGINGFACEHUB_API_TOKEN=your_huggingface_token_here

# --- Models --------------------------------------------------------------
# llama-3.3-70b-versatile was deprecated by Groq on 2026-08-16.
# openai/gpt-oss-120b is the current recommended production replacement.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.2

# Multilingual (Hindi + English) sentence embedding model served via the
# Hugging Face Inference API.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBEDDING_PROVIDER=hf-inference

# --- RAG tuning -----------------------------------------------------------
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVER_K=5

# --- Session store ------------------------------------------------------
SESSION_TTL_MINUTES=120
MAX_SESSIONS=200

# --- App / CORS -----------------------------------------------------------
APP_ENV=development
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=30
